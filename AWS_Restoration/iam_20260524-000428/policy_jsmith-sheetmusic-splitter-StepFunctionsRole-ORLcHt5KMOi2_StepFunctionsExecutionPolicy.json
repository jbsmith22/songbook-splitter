{
    "RoleName": "jsmith-sheetmusic-splitter-StepFunctionsRole-ORLcHt5KMOi2",
    "PolicyName": "StepFunctionsExecutionPolicy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "lambda:InvokeFunction"
                ],
                "Resource": [
                    "arn:aws:lambda:us-east-1:227027150061:function:jsmith-sheetmusic-splitter-check-processed",
                    "arn:aws:lambda:us-east-1:227027150061:function:jsmith-sheetmusic-splitter-record-start",
                    "arn:aws:lambda:us-east-1:227027150061:function:jsmith-sheetmusic-splitter-record-success",
                    "arn:aws:lambda:us-east-1:227027150061:function:jsmith-sheetmusic-splitter-record-failure",
                    "arn:aws:lambda:us-east-1:227027150061:function:jsmith-sheetmusic-splitter-record-manual-review"
                ],
                "Effect": "Allow"
            },
            {
                "Action": [
                    "ecs:RunTask",
                    "ecs:StopTask",
                    "ecs:DescribeTasks"
                ],
                "Resource": "*",
                "Effect": "Allow"
            },
            {
                "Action": [
                    "iam:PassRole"
                ],
                "Resource": [
                    "arn:aws:iam::227027150061:role/jsmith-sheetmusic-splitter-ECSTaskExecutionRole-lk6cYO4BePSL",
                    "arn:aws:iam::227027150061:role/jsmith-sheetmusic-splitter-ECSTaskRole-w6lDb4md62rc"
                ],
                "Effect": "Allow"
            },
            {
                "Action": [
                    "events:PutTargets",
                    "events:PutRule",
                    "events:DescribeRule"
                ],
                "Resource": "*",
                "Effect": "Allow"
            }
        ]
    }
}

